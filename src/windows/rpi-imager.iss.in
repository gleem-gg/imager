#define MyAppName "Gleem Imager"
#define MyAppVersion "@IMAGER_VERSION_STR@"
#define MyAppPublisher "Gleem"
#define GleemURL "https://gleem.gg"
#define ImagerRepoRootURL "https://github.com/gleem-gg/imager"
#define ImagerRepoIssuesURL "https://github.com/gleem-gg/imager/issues"
#define MyAppExeName "gleem-imager.exe"

[Setup]
; Gleem Imager's own AppId: never Raspberry Pi Imager's, so the two install side by side.
AppId={{7BE4FAD8-3F33-452E-8D29-052EAAEDFE89}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#GleemURL}
AppSupportURL={#ImagerRepoIssuesURL}
AppUpdatesURL={#ImagerRepoRootURL}
DefaultDirName={autopf}\{#MyAppPublisher}\Imager
DefaultGroupName=Gleem
AllowNoIcons=yes
LicenseFile=@CMAKE_BINARY_DIR@\deploy\license.txt
OutputDir=@CMAKE_BINARY_DIR@\installer
OutputBaseFilename=gleem-imager-{#MyAppVersion}
SetupIconFile=@CMAKE_SOURCE_DIR@\icons\rpi-imager.ico
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern dynamic
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0.15063
PrivilegesRequired=admin
UninstallDisplayIcon={app}\{#MyAppExeName},0
UninstallDisplayName={#MyAppName}
; Defaults to 'auto', which hides the Select Destination Location page whenever a
; previous install is recorded in the registry. Together with DisableReadyPage that
; leaves an upgrader unable to see or correct the destination at all - see
; InitializeWizard below.
DisableDirPage=no
DisableProgramGroupPage=yes
DisableWelcomePage=no
DisableReadyPage=yes
DisableFinishedPage=no
CreateUninstallRegKey=yes
#ifdef SIGNING_ENABLED
SignTool=sign $f
SignedUninstaller=yes
#endif

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"
Name: "dutch"; MessagesFile: "compiler:Languages\Dutch.isl"
Name: "french"; MessagesFile: "compiler:Languages\French.isl"
Name: "german"; MessagesFile: "compiler:Languages\German.isl"
Name: "italian"; MessagesFile: "compiler:Languages\Italian.isl"
Name: "spanish"; MessagesFile: "compiler:Languages\Spanish.isl"

[Messages]
italian.SetupWindowTitle=Installazione di {#MyAppName} {#MyAppVersion}

[CustomMessages]
italian.NameAndVersion=%1 %2
italian.AdditionalIcons=Collegamenti:
italian.CreateDesktopIcon=Crea collegamento programma sul &desktop
italian.CreateQuickLaunchIcon=Crea collegamento programma nella &barra 'Avvio veloce'
italian.ProgramOnTheWeb=Sito web %1
italian.LaunchProgram=Esegui %1

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Registry]
Root: HKLM; Subkey: "Software\Microsoft\Windows\CurrentVersion\App Paths\{#MyAppExeName}"; ValueType: string; ValueName: ""; ValueData: "{app}\{#MyAppExeName}"; Flags: uninsdeletekey
Root: HKLM; Subkey: "Software\Classes\.zip\OpenWithProgIds"; ValueType: string; ValueName: "GLEEM_IMAGER"; ValueData: ""; Flags: uninsdeletevalue
Root: HKLM; Subkey: "Software\Classes\.gz\OpenWithProgIds"; ValueType: string; ValueName: "GLEEM_IMAGER"; ValueData: ""; Flags: uninsdeletevalue
Root: HKLM; Subkey: "Software\Classes\.xz\OpenWithProgIds"; ValueType: string; ValueName: "GLEEM_IMAGER"; ValueData: ""; Flags: uninsdeletevalue
Root: HKLM; Subkey: "Software\Classes\.img\OpenWithProgIds"; ValueType: string; ValueName: "GLEEM_IMAGER"; ValueData: ""; Flags: uninsdeletevalue
Root: HKLM; Subkey: "Software\Classes\.wic\OpenWithProgIds"; ValueType: string; ValueName: "GLEEM_IMAGER"; ValueData: ""; Flags: uninsdeletevalue
Root: HKLM; Subkey: "Software\Classes\.zstd\OpenWithProgIds"; ValueType: string; ValueName: "GLEEM_IMAGER"; ValueData: ""; Flags: uninsdeletevalue
Root: HKLM; Subkey: "Software\Classes\GLEEM_IMAGER\shell\open"; ValueType: string; ValueName: "FriendlyAppName"; ValueData: "{#MyAppName}"; Flags: uninsdeletekey
Root: HKLM; Subkey: "Software\Classes\GLEEM_IMAGER\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\{#MyAppExeName}"" ""%1"""; Flags: uninsdeletekey

; Register .gleem-imager-manifest file type (repository manifest files)
; Extension defined in src/config.h (MANIFEST_EXTENSION)
Root: HKLM; Subkey: "Software\Classes\.gleem-imager-manifest"; ValueType: string; ValueName: ""; ValueData: "GLEEM_IMAGER_MANIFEST"; Flags: uninsdeletekey
Root: HKLM; Subkey: "Software\Classes\.gleem-imager-manifest"; ValueType: string; ValueName: "Content Type"; ValueData: "application/vnd.gleem.imager-manifest+json"; Flags: uninsdeletekey
Root: HKLM; Subkey: "Software\Classes\GLEEM_IMAGER_MANIFEST"; ValueType: string; ValueName: ""; ValueData: "Gleem Imager Manifest"; Flags: uninsdeletekey
Root: HKLM; Subkey: "Software\Classes\GLEEM_IMAGER_MANIFEST\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: "{app}\{#MyAppExeName},0"; Flags: uninsdeletekey
Root: HKLM; Subkey: "Software\Classes\GLEEM_IMAGER_MANIFEST\shell\open"; ValueType: string; ValueName: "FriendlyAppName"; ValueData: "{#MyAppName}"; Flags: uninsdeletekey
Root: HKLM; Subkey: "Software\Classes\GLEEM_IMAGER_MANIFEST\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\{#MyAppExeName}"" ""%1"""; Flags: uninsdeletekey

; Register gleem-imager:// URL protocol handler
Root: HKCR; Subkey: "gleem-imager"; ValueType: string; ValueName: ""; ValueData: "URL:Gleem Imager"; Flags: uninsdeletekey
Root: HKCR; Subkey: "gleem-imager"; ValueType: string; ValueName: "URL Protocol"; ValueData: ""; Flags: uninsdeletekey
Root: HKCR; Subkey: "gleem-imager\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: "{app}\{#MyAppExeName},1"; Flags: uninsdeletekey
Root: HKCR; Subkey: "gleem-imager\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\rpi-imager-callback-relay.exe"" ""%1"""; Flags: uninsdeletekey

[Files]
; Main program files
Source: "@CMAKE_BINARY_DIR@\deploy\{#MyAppExeName}"; DestDir: "{app}"; Flags: ignoreversion signonce

Source: "@CMAKE_BINARY_DIR@\deploy\gleem-imager-cli.cmd"; DestDir: "{app}"; Flags: ignoreversion
Source: "@CMAKE_BINARY_DIR@\deploy\rpi-imager-callback-relay.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "@CMAKE_BINARY_DIR@\deploy\license.txt"; DestDir: "{app}"; Flags: ignoreversion
Source: "@CMAKE_BINARY_DIR@\deploy\NOTICE"; DestDir: "{app}"; Flags: ignoreversion

; Core DLLs
Source: "@CMAKE_BINARY_DIR@\deploy\D3Dcompiler_47.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "@CMAKE_BINARY_DIR@\deploy\libgcc_s_seh-1.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "@CMAKE_BINARY_DIR@\deploy\libstdc++-6.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "@CMAKE_BINARY_DIR@\deploy\libwinpthread-1.dll"; DestDir: "{app}"; Flags: ignoreversion

; Qt DLLs
Source: "@CMAKE_BINARY_DIR@\deploy\Qt6*.dll"; DestDir: "{app}"; Flags: ignoreversion

; Qt Plugin directories
Source: "@CMAKE_BINARY_DIR@\deploy\generic\*"; DestDir: "{app}\generic"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "@CMAKE_BINARY_DIR@\deploy\iconengines\*"; DestDir: "{app}\iconengines"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "@CMAKE_BINARY_DIR@\deploy\imageformats\*"; DestDir: "{app}\imageformats"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "@CMAKE_BINARY_DIR@\deploy\networkinformation\*"; DestDir: "{app}\networkinformation"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "@CMAKE_BINARY_DIR@\deploy\platforminputcontexts\*"; DestDir: "{app}\platforminputcontexts"; Flags: ignoreversion recursesubdirs createallsubdirs skipifsourcedoesntexist
Source: "@CMAKE_BINARY_DIR@\deploy\platforms\*"; DestDir: "{app}\platforms"; Flags: ignoreversion recursesubdirs createallsubdirs
; Source: "@CMAKE_BINARY_DIR@\deploy\styles\*"; DestDir: "{app}\styles"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "@CMAKE_BINARY_DIR@\deploy\tls\*"; DestDir: "{app}\tls"; Flags: ignoreversion recursesubdirs createallsubdirs

; QML directories
Source: "@CMAKE_BINARY_DIR@\deploy\qml\*"; DestDir: "{app}\qml"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{group}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; AfterInstall: SetElevationBit('{group}\{#MyAppName}.lnk')
Name: "{commondesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon; AfterInstall: SetElevationBit('{commondesktop}\{#MyAppName}.lnk')

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent runascurrentuser

[Code]

// Inno doesn't support setting 'Run as Administrator' on icons natively
// https://stackoverflow.com/a/44082068
procedure SetElevationBit(Filename: string);
var
  Buffer: string;
  Stream: TStream;
begin
  Filename := ExpandConstant(Filename);
  Log('Setting elevation bit for ' + Filename);

  Stream := TFileStream.Create(FileName, fmOpenReadWrite);
  try
    Stream.Seek(21, soFromBeginning);
    SetLength(Buffer, 1);
    Stream.ReadBuffer(Buffer, 1);
    Buffer[1] := Chr(Ord(Buffer[1]) or $20);
    Stream.Seek(-1, soFromCurrent);
    Stream.WriteBuffer(Buffer, 1);
  finally
    Stream.Free;
  end;
end;

// Helper function to find a process by name
function FindProcess(ExeFileName: String; var ProcessID: Integer): Boolean;
var
  CmdLine: String;
  ResultCode: Integer;
  OutputFile: String;
  FileLines: TArrayOfString;
  I: Integer;
  ProcessLine: String;
  IdStr: String;
begin
  Result := False;
  OutputFile := ExpandConstant('{tmp}\processes.txt');
  
  // Use tasklist to get running processes
  CmdLine := Format('/c tasklist /FI "IMAGENAME eq %s" /FO CSV /NH > "%s"', [ExeFileName, OutputFile]);
  ShellExec('', 'cmd.exe', CmdLine, '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
  
  if ResultCode = 0 then
  begin
    // Read the output file
    if LoadStringsFromFile(OutputFile, FileLines) then
    begin
      for I := 0 to GetArrayLength(FileLines) - 1 do
      begin
        ProcessLine := FileLines[I];
        // Process line is in CSV format: "imagename","PID",...
        if Pos('"' + ExeFileName + '"', ProcessLine) = 1 then
        begin
          // Get the PID
          ProcessLine := Copy(ProcessLine, Length(ExeFileName) + 3, Length(ProcessLine));
          IdStr := '';
          
          // Extract numeric PID
          while (Length(ProcessLine) > 0) and (ProcessLine[1] <> '"') do
          begin
            ProcessLine := Copy(ProcessLine, 2, Length(ProcessLine));
          end;
          
          if Length(ProcessLine) > 0 then 
          begin
            ProcessLine := Copy(ProcessLine, 2, Length(ProcessLine)); // Skip "
            while (Length(ProcessLine) > 0) and (ProcessLine[1] <> '"') do
            begin
              IdStr := IdStr + ProcessLine[1];
              ProcessLine := Copy(ProcessLine, 2, Length(ProcessLine));
            end;
            
            ProcessID := StrToIntDef(IdStr, 0);
            if ProcessID > 0 then
            begin
              Result := True;
              break;
            end;
          end;
        end;
      end;
    end;
    
    // Clean up temporary file
    DeleteFile(OutputFile);
  end;
end;

// Function to check if Windows 10 or later
function IsWindows10OrNewer: Boolean;
var
  Version: TWindowsVersion;
begin
  GetWindowsVersionEx(Version);
  Result := (Version.Major >= 10);
end; 

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var
  CacheFile, CacheDir: string;
begin
  if CurUninstallStep = usPostUninstall then begin
    // Delete the cached OS download (potentially several GB). Path is read
    // from QSettings at HKCU\Software\Gleem\Gleem Imager\caching\lastFileName.
    // The basename check guards against a tampered HKCU value being used to
    // point this admin-elevated uninstaller at an unrelated file.
    if RegQueryStringValue(HKCU, 'Software\Gleem\Gleem Imager\caching',
                           'lastFileName', CacheFile) then
    begin
      if (CacheFile <> '') and
         (CompareText(ExtractFileName(CacheFile), 'lastdownload.cache') = 0) and
         FileExists(CacheFile) then
      begin
        Log('Removing cached OS download: ' + CacheFile);
        DeleteFile(CacheFile);

        CacheDir := ExtractFileDir(CacheFile);
        if (CacheDir <> '') and DirExists(CacheDir) then
          RemoveDir(CacheDir); // no-op unless empty
      end;
    end;

    // Delete the saved image-customisation presets. These persist Wi-Fi PSK
    // (PBKDF2 hash, usable as the live wpa_supplicant credential), the Linux
    // user account password hash, and SSH keys; leaving them in HKCU after
    // uninstall is a privacy issue.
    if RegKeyExists(HKCU, 'Software\Gleem\Gleem Imager\imagecustomization') then begin
      Log('Removing saved image customisation settings (Wi-Fi/user/SSH credentials)');
      RegDeleteKeyIncludingSubkeys(HKCU, 'Software\Gleem\Gleem Imager\imagecustomization');
    end;

    // Other per-user QSettings (window position, language, telemetry choice,
    // lastpath, etc.) are intentionally preserved so reinstalling restores
    // user preferences.
  end;
end;

function InitializeSetup(): Boolean;
var
  rc: Integer;
  running: Boolean;
  pid: Integer;
begin
  // make sure app not running
  running := FindProcess('gleem-imager.exe', pid);
  if running then begin
    if MsgBox('Gleem Imager is running and needs to be closed before continuing. Close it now?',
              mbConfirmation, MB_YESNO) <> IDYES then
    begin Result := False; Exit; end;
    
    ShellExec('', 'taskkill.exe', '/IM gleem-imager.exe /F', '', SW_HIDE, ewWaitUntilTerminated, rc);
    // taskkill may fail if process exited between detection and kill attempt (race condition)
    // Re-check if process is actually still running
    Sleep(500); // Give process time to fully terminate
    if FindProcess('gleem-imager.exe', pid) then begin
      MsgBox('Failed to close Gleem Imager. Please close it manually and try again.', mbError, MB_OK);
      Result := False; Exit;
    end;
  end;

  // OS check (your IsWindows10OrNewer helper)
  if not IsWindows10OrNewer then begin
    MsgBox('This application requires Windows 10 or later.', mbError, MB_OK);
    Result := False; Exit;
  end;

  Result := True;
end;

// DirEdit is prefilled from the previous install's recorded app path, because
// UsePreviousAppDir defaults to yes. Nothing validates that path until
// TMainForm.Install does so as its very first act - by which point the wizard has
// already switched to the Installing page - and failure there aborts the install
// behind Inno's bare "The drive or UNC share you selected does not exist or is not
// accessible" message. An external drive that has been removed or re-lettered, or a
// share that is no longer mapped, is enough to trigger it, and a silent install has
// no page on which to correct it. Fall back to the default location instead.
procedure InitializeWizard();
var
  Dir, Root: string;
begin
  // An explicit /DIR= is the operator's decision. Leave it to fail loudly rather
  // than silently redirecting an unattended install somewhere else.
  if ExpandConstant('{param:DIR}') <> '' then
    Exit;

  Dir := WizardForm.DirEdit.Text;
  Root := ExtractFileDrive(Dir);
  if Root = '' then
    Exit;

  // Inno's own check calls SHPathPrepareForWrite first, which can reconnect a mapped
  // network drive - those start disconnected in an elevated process. We have no
  // equivalent, so this test is the more pessimistic one: a share that would have
  // reconnected gets relocated instead. Hence the log lines.
  if not DirExists(AddBackslash(Root)) then begin
    Log('Recorded install directory is unreachable: ' + Dir);
    Dir := ExpandConstant('{autopf}\{#MyAppPublisher}\Imager');  // matches DefaultDirName
    Log('Falling back to default install directory: ' + Dir);
    WizardForm.DirEdit.Text := Dir;
  end;
end;
